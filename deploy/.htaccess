# cPanel / Apache yapılandırması — public_html kökine kopyalanır.
#
# Passenger'ın kendi blokları (PassengerAppRoot, PassengerBaseURI,
# PassengerNodejs...) cPanel'in "Setup Node.js App" arayüzü tarafından bu
# dosyanın BAŞINA otomatik yazılır. O bloğu SİLMEYİN; aşağıdakileri onun
# altına ekleyin.

# ---------------------------------------------------------------------------
# 0) YAYIN ÖNCESİ IP KISITLAMASI  —  VARSAYILAN: KAPALI
#
# Siteyi yalnızca kendi IP'nize açar; herkese 403 döner. Amaç, arama motoru
# botları gelmeden önce canlı ortamda test yapabilmek.
#
# NEDEN robots.txt DEĞİL: `Disallow: /` koyup sonra kaldırmayı unutursanız
# site aylarca görünmez kalır. IP kısıtlaması geride iz bırakmaz — kaldırdığınız
# an temizdir.
#
# AÇMAK İÇİN: aşağıdaki bloğun başındaki # işaretlerini kaldırın ve kendi
# IP'nizi yazın. IP'nizi https://ifconfig.me adresinden öğrenebilirsiniz.
#
# ⚠ KENDİNİZİ KİLİTLEME RİSKİ: ev bağlantılarının çoğunda IP dinamiktir.
#   Değişirse siteye giremezsiniz — cPanel Dosya Yöneticisi'nden bu dosyayı
#   düzenleyebileceğinizi önceden teyit edin. Telefonunuzun mobil IP'sini de
#   ikinci satır olarak eklemenizi öneririm.
#
# ⚠ Test bitince BU BLOĞU TEKRAR YORUMA ALIN. Açık kaldığı sürece SSL
#   kontrolü, uptime izleme ve WhatsApp bağlantı önizlemesi de 403 alır.
#
# <RequireAny>
#   Require ip 88.0.0.0        # ← kendi IP'niz
#   Require ip 78.0.0.0        # ← mobil IP'niz (isteğe bağlı, yedek)
#   Require ip 127.0.0.1       # sunucunun kendisi (cron, yedekleme)
# </RequireAny>
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1) SIKIŞTIRMA
#
# Ölçüldü: sıkıştırma olmadan ana sayfa 187 KB ham iniyor. Metin içerikte
# gzip tipik olarak %75–85 kazandırıyor. Nitro yalnızca statik varlıkları
# (JS/CSS) derleme zamanında sıkıştırabiliyor; SSR ile üretilen HTML her
# istekte yeniden oluştuğu için onun sıkıştırması bu katmanda yapılmalı.
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # Zaten sıkıştırılmış biçimleri tekrar sıkıştırmak boşa CPU.
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|br|woff2?)$ no-gzip dont-vary
</IfModule>

# AŞAĞIDAKİ _nuxt KURALLARI VARSAYILAN KURULUMDA ÇALIŞMAZ — bilerek.
#
# Ölçüldü: Nitro'nun node-server çıktısı statik varlıkları KENDİSİ
# sıkıştırılmış olarak sunuyor. Bir .js dosyası `Accept-Encoding: br` ile
# istendiğinde `Content-Encoding: br` ve 644 bayt dönüyor (sıkıştırmasız
# 1652 bayt), üstelik `cache-control: public, max-age=31536000, immutable`
# başlığını da Node veriyor.
#
# Bu yüzden `.output/public` içeriğini public_html'e KOPYALAMAYA GEREK YOK;
# uygulama kökü belge kökünün dışında durabilir. Kopyalanmadığı için
# aşağıdaki RewriteCond `-f` kontrolleri eşleşmez ve kurallar sessizce
# devre dışı kalır.
#
# Kurallar yine de duruyor: ileride statikleri Apache'ye devretmek
# isterseniz (`.output/public/*` → `public_html/`) tek satır değişiklik
# yapmadan çalışmaya başlarlar.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{DOCUMENT_ROOT}/_nuxt/$1.br -f
  RewriteRule ^_nuxt/(.*)$ /_nuxt/$1.br [L]

  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{DOCUMENT_ROOT}/_nuxt/$1.gz -f
  RewriteRule ^_nuxt/(.*)$ /_nuxt/$1.gz [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.js\.br$">
    Header set Content-Encoding br
    Header set Content-Type "application/javascript"
  </FilesMatch>
  <FilesMatch "\.css\.br$">
    Header set Content-Encoding br
    Header set Content-Type "text/css"
  </FilesMatch>
  <FilesMatch "\.js\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type "application/javascript"
  </FilesMatch>
  <FilesMatch "\.css\.gz$">
    Header set Content-Encoding gzip
    Header set Content-Type "text/css"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 2) PANELDEN YÜKLENEN GÖRSELLER — burada bir kural YOK, bilerek
#
# Burada önceden şöyle bir blok vardı:
#
#   <IfModule mod_alias.c>
#     Alias /yuklemeler /home/KULLANICI/yuklemeler
#   </IfModule>
#   <Directory "/home/KULLANICI/yuklemeler"> ... </Directory>
#
# BU BLOK KALDIRILDI ÇÜNKÜ ÇALIŞMIYOR. `Alias` ve `<Directory>` yalnızca
# sunucu ve sanal host yapılandırmasında geçerli; `.htaccess` içinde
# kullanılamazlar. Apache bunu gördüğünde ya yok sayar ya da tüm site için
# 500 döndürür. Yani /yuklemeler istekleri hiçbir zaman Apache tarafından
# karşılanmadı; klasör de yanlış yere (uygulama kökünün dışına) konduğu için
# panelden yüklenen tüm görseller 404 verdi.
#
# DOĞRUSU: dosyaları uygulamanın kendi rotası servis ediyor —
# server/routes/yuklemeler/[...ad].get.ts. O rota klasörü
# `process.cwd() + /yuklemeler` olarak arıyor, yani UYGULAMA KÖKÜNÜN İÇİNDE:
#
#   /home/KULLANICI/nakliye/
#   ├── .output/
#   ├── scripts/
#   └── yuklemeler/     ← BURAYA
#
# Bu konum `.output` DIŞINDA olduğu için yeni sürüm atarken silinmiyor.
#
# Rota zaten Apache'nin yapacağı her şeyi yapıyor: doğru Content-Type,
# `Cache-Control: public, max-age=31536000, immutable`, ETag, Last-Modified
# ve koşullu istekte 304. Ayrıca yol kaçışına ve desteklenmeyen uzantılara
# karşı koruması var. Apache katmanı bu iş için gerekli değil.
# ---------------------------------------------------------------------------

<IfModule mod_expires.c>
  ExpiresActive On
  # Dosya adları içerik hash'i taşıdığı için içerik değişince ad da değişir.
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# 3) HTTPS'e yönlendirme
#
# HSTS başlığını uygulama zaten gönderiyor; bu kural ilk isteği (henüz HSTS
# öğrenilmemişken) güvenli tarafa alıyor.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>
