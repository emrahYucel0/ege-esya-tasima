// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  output        = "./generated/sqlite" // SQLite için ayrı bir istemci dizini
}

datasource db {
  provider = "sqlite"
  url      = env("SQLITE_DATABASE_URL")
}

//--------------------- NAVBAR-----------------------

model Navbar {
  id          Int      @id @default(autoincrement())
  sectionName String   @unique @default("navbars")
  title       String
  subtitle    String
  phone       String
  createdAt   DateTime @default(now())
}

//--------------------- HERO-----------------------

model HeroPage {
  id              Int      @id @default(autoincrement())
  sectionName     String   @unique @default("heros")
  title           String
  subtitle        String
  description     String
  primaryButton   String
  primaryLink     String
  secondaryButton String
  secondaryLink   String
  image           String
  createdAt       DateTime @default(now())
}

//--------------------- FOOTER-----------------------

model Footer {
  id          Int      @id @default(autoincrement())
  sectionName String   @unique @default("footers")
  address     String
  phone       String
  email       String
  copyright   String
  createdAt   DateTime
  updatedAt   DateTime

  socialLinks FooterSocialLink[]
  regionLinks FooterRegionLink[]
  quickLinks  QuickLink[]
  blogLinks   FooterBlogLink[]
}

model FooterSocialLink {
  id       Int    @id @default(autoincrement())
  name     String
  url      String
  footer   Footer @relation(fields: [footerId], references: [id])
  footerId Int
}

model FooterBlogLink {
  id       Int    @id @default(autoincrement())
  name     String
  url      String
  footer   Footer @relation(fields: [footerId], references: [id])
  footerId Int
}

model QuickLink {
  id       Int    @id @default(autoincrement())
  name     String
  url      String
  footer   Footer @relation(fields: [footerId], references: [id])
  footerId Int
}

model FooterRegionLink {
  id       Int    @id @default(autoincrement())
  name     String
  url      String
  footer   Footer @relation(fields: [footerId], references: [id])
  footerId Int
}

//--------------------- FACT-----------------------

model Fact {
  id          Int             @id @default(autoincrement())
  sectionName String          @unique @default("facts")
  subtitle    String
  title       String
  description String
  phoneLabel  String
  phone       String
  statistics  FactStatistic[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model FactStatistic {
  id        Int      @id @default(autoincrement())
  title     String
  fact      Fact     @relation(fields: [factId], references: [id])
  factId    Int
  createdAt DateTime @default(now())
}

//--------------------- FEATURE-----------------------

model Feature {
  id           Int           @id @default(autoincrement())
  sectionName  String        @unique @default("features")
  subtitle     String
  title        String
  image        String
  featureTypes FeatureType[]
  createdAt    DateTime      @default(now())
}

model FeatureType {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  feature     Feature @relation(fields: [featureId], references: [id])
  featureId   Int
}

//--------------------- PRICINGPLAN-----------------------

model PricingPlan {
  id               Int            @id @default(autoincrement())
  sectionName      String         @unique @default("pricings")
  subtitle         String
  title            String
  basicFeatures    BasicPlan[]
  standardFeatures StandardPlan[]
  advancedFeatures AdvancedPlan[]
}

model BasicPlan {
  id             Int             @id @default(autoincrement())
  planName       String
  price          String
  basicPlanTypes BasicPlanType[]
  pricingPlan    PricingPlan     @relation(fields: [pricingPlanId], references: [id])
  pricingPlanId  Int
}

model StandardPlan {
  id                Int                @id @default(autoincrement())
  planName          String
  price             String
  standardPlanTypes StandardPlanType[]
  pricingPlan       PricingPlan        @relation(fields: [pricingPlanId], references: [id])
  pricingPlanId     Int
}

model AdvancedPlan {
  id                Int                @id @default(autoincrement())
  planName          String
  price             String
  advancedPlanTypes AdvancedPlanType[]
  pricingPlan       PricingPlan        @relation(fields: [pricingPlanId], references: [id])
  pricingPlanId     Int
}

model BasicPlanType {
  id          Int       @id @default(autoincrement())
  description String
  basicPlan   BasicPlan @relation(fields: [basicPlanId], references: [id], onDelete: Cascade)
  basicPlanId Int
}

model StandardPlanType {
  id             Int          @id @default(autoincrement())
  description    String
  standardPlan   StandardPlan @relation(fields: [standardPlanId], references: [id], onDelete: Cascade)
  standardPlanId Int
}

model AdvancedPlanType {
  id             Int          @id @default(autoincrement())
  description    String
  advancedPlan   AdvancedPlan @relation(fields: [advancedPlanId], references: [id], onDelete: Cascade)
  advancedPlanId Int
}

//--------------------- QUOTE-----------------------

model QuoteRequest {
  id          Int      @id @default(autoincrement())
  sectionName String   @unique @default("quotes")
  subtitle    String
  title       String
  description String
  phoneLabel  String
  phone       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//--------------------- TESTIMONIAL-----------------------

model Testimonial {
  id                 Int                 @id @default(autoincrement())
  sectionName        String              @unique @default("testimonials")
  title              String
  subtitle           String
  testimonialDetails TestimonialDetail[]

  createdAt DateTime @default(now())
}

model TestimonialDetail {
  id            Int         @id @default(autoincrement())
  name          String
  profession    String
  description   String
  testimonial   Testimonial @relation(fields: [testimonialId], references: [id])
  testimonialId Int
}

//--------------------- ABOUT-----------------------

model About {
  id          Int      @id @default(autoincrement())
  sectionName String   @unique @default("abouts")
  title       String
  subtitle    String
  content     String // TipTap içeriği burada HTML olarak saklanacak  description 
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

//--------------------- POST-----------------------

model Post {
  id         Int      @id @default(autoincrement())
  title      String?
  subtitle   String?
  shortTitle String?
  author     String
  slug       String   @unique
  content    String // TipTap içeriği burada HTML olarak saklanacak  description 
  excerpt    String
  image      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

//--------------------- Region-----------------------

model Region {
  id         Int      @id @default(autoincrement())
  title      String?
  subtitle   String?
  shortTitle String?
  slug       String   @unique
  content    String // TipTap içeriği burada HTML olarak saklanacak  description 
  excerpt    String // Bolgelerimiz sayfasındaki kart için kısa açıklama
  image      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

//--------------------- Image-----------------------

model StoredFile {
  id           String   @id @default(uuid())
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("user") // "admin" veya "user"
  createdAt DateTime @default(now())
}
